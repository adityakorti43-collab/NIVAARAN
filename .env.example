# Copy this file to `.env` in the same folder and fill in the values. `.env` is gitignored and read by the API at start-up;
# real environment variables take precedence. Never commit `.env`, and never put any of these in frontend code or a VITE_ variable.
# NIVAARAN_DATA_DIR=backend/data/runtime
# NIVAARAN_MAX_UPLOAD_MB=15
# NIVAARAN_MAX_PAGES=200
# auto | sentence-transformers | lsa
# NIVAARAN_EMBEDDINGS=auto
# NIVAARAN_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# auto | off
# NIVAARAN_RERANKER=auto
# NIVAARAN_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# NIVAARAN_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# NIVAARAN_LOG_LEVEL=INFO

# Accounts and sessions
# NIVAARAN_SESSION_DAYS=7
# Set to 1 when served over HTTPS so the session cookie is marked Secure.
# NIVAARAN_COOKIE_SECURE=0

# Optional live AI (off unless set). The assistant's answers are always built from cited clauses and engine
# results; when enabled, Claude may only reword them, and any rewording that introduces a new number is discarded.
# NIVAARAN_AI_PROVIDER=anthropic
# NIVAARAN_AI_MODEL=claude-opus-5-5
# ANTHROPIC_API_KEY=<your key — never commit it>

# --- Sign-in: Google only. It stays switched off (and says so on the sign-in page) until configured. ---
# The public address people use to open the site. Google redirects back to {PUBLIC_URL}/api/auth/google/callback,
# so this must match the redirect URI registered in Google Cloud exactly. Production build on one port: http://localhost:8000
NIVAARAN_PUBLIC_URL=http://localhost:8000

# Google: Google Cloud Console → APIs & Services → Credentials → Create OAuth client ID → "Web application".
#   Authorised redirect URI: {NIVAARAN_PUBLIC_URL}/api/auth/google/callback
NIVAARAN_GOOGLE_CLIENT_ID=
NIVAARAN_GOOGLE_CLIENT_SECRET=

# --- Natural voice + page translation. Choose ONE provider: Google Gemini (free tier) or Azure. ---
# Google Gemini: aistudio.google.com → Get API key (no card). On the free tier Google may use submitted text to improve
# its products. Optional: NIVAARAN_GEMINI_TEXT_MODEL, NIVAARAN_GEMINI_TTS_MODEL, NIVAARAN_GEMINI_VOICE (default Kore).
NIVAARAN_GEMINI_API_KEY=

# Or Azure: natural voice for read-aloud, from Azure AI Speech. Free tier: 500,000 characters a month.
# portal.azure.com → Create a resource → "Speech" → Keys and Endpoint: copy KEY 1 and the Location/Region (e.g. centralindia).
# Without these, the page uses the browser's own voices (many Windows PCs have no Hindi voice).
NIVAARAN_AZURE_SPEECH_KEY=
NIVAARAN_AZURE_SPEECH_REGION=
# Optional voice overrides: NIVAARAN_TTS_VOICE_EN=en-IN-NeerjaNeural  NIVAARAN_TTS_VOICE_HI=hi-IN-SwaraNeural

# Page translation into Indian languages (Azure AI Translator; free tier 2 million characters a month).
# One multi-service "Azure AI services" resource covers both voice and translation (leave these empty to reuse the
# speech key and region). Otherwise create a "Translator" resource.
NIVAARAN_AZURE_TRANSLATOR_KEY=
NIVAARAN_AZURE_TRANSLATOR_REGION=
